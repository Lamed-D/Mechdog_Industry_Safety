# Codex 명령 규칙 (prefix_rule). decision: allow | prompt | forbidden
# 승인·병합은 사용자만, main 직접 푸시·강제 푸시·훅 우회 금지
prefix_rule(pattern=["gh", "pr", "merge"], decision="forbidden")
prefix_rule(pattern=["gh", "pr", "review"], decision="forbidden")
prefix_rule(pattern=["gh", "repo", "delete"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "push", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force-with-lease"], decision="forbidden")
prefix_rule(pattern=["git", "push", "origin", "main"], decision="forbidden")
prefix_rule(pattern=["git", "push", "origin", "--delete"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--no-verify"], decision="forbidden")
prefix_rule(pattern=["git", "commit", "--no-verify"], decision="forbidden")
prefix_rule(pattern=["git", "commit", "-n"], decision="forbidden")
prefix_rule(pattern=["git", "config", "core.hooksPath"], decision="forbidden")

# 실제 로봇에 펌웨어·파일을 올리는 명령은 매번 사용자에게 묻는다
prefix_rule(pattern=["esptool"], decision="prompt")
prefix_rule(pattern=["esptool.py"], decision="prompt")
prefix_rule(pattern=["python", "-m", "esptool"], decision="prompt")
prefix_rule(pattern=["mpremote"], decision="prompt")
prefix_rule(pattern=["ampy"], decision="prompt")
prefix_rule(pattern=["rshell"], decision="prompt")

# 자주 쓰는 안전한 명령은 묻지 않는다
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow")
prefix_rule(pattern=["gh", "issue", "list"], decision="allow")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow")
prefix_rule(pattern=["python", "-m", "unittest"], decision="allow")
prefix_rule(pattern=["python", "tools/check_confidential.py"], decision="allow")
